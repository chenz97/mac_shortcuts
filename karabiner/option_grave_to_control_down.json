{
  "title": "Option+Grave to Control+Down",
  "rules": [
    {
      "description": "将 Option+` 映射为 Control+↓",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "grave_accent_and_tilde",
            "modifiers": {
              "mandatory": ["option"],
              "optional": ["caps_lock"]
            }
          },
          "to": [
            {
              "key_code": "down_arrow",
              "modifiers": ["left_control"],
              "repeat": false
            }
          ]
        }
      ]
    }
  ]
}
