{
  "title": "Non-US Backslash to Left Shift",
  "rules": [
    {
      "description": "将 non_us_backslash 映射为左 Shift",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "non_us_backslash",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "left_shift"
            }
          ]
        }
      ]
    }
  ]
}
